{
  "name": "nexora-studio",
  "productName": "NEXORA Studio",
  "version": "1.5.0",
  "description": "NEXORA Studio — unified creative suite: video editing, layered image editing, motion, shared assets",
  "main": "electron/main.js",
  "repository": { "type": "git", "url": "https://github.com/sysamiryasar/nexora-studio.git" },
  "homepage": "https://github.com/sysamiryasar/nexora-studio",
  "author": "NEXORA Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nexora.studio",
    "productName": "NEXORA Studio",
    "copyright": "MIT License",
    "asar": false,
    "files": ["electron/**/*", "index.html", "styles.css", "fx.js", "engine.js", "viewport.js", "panels.js", "timeline.js", "features.js", "main.js", "vendor/**/*", "nexora/**/*", "tests/**/*", "docs/**/*", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md", "README.md", "!**/*.example.json"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXORA Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "NEXORA Studio",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "NEXORA-Studio-Setup-win-x64.${ext}"
    },
    "mac": { "icon": "build/icon.icns", "category": "public.app-category.video" },
    "linux": { "icon": "build/icon.png", "category": "AudioVideo" }
  }
}
